{
  "name": "__MSG_extensionName__",
  "short_name": "Get Joke",
  "version": "2.0.1",
  "author": "MarkAlexI",
  "homepage_url": "https://ext.pp.ua/get-joke-extension.html",
  "manifest_version": 3,
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png",
    "192": "images/icon-192.png"
  },
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "{d9b8e5c3-3c54-4f6a-bf91-6a4b80d8e978}"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "__MSG_shortcutOpen__"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; connect-src https://v2.jokeapi.dev; base-uri 'none'"
  },
  "default_locale": "en"
}
